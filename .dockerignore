# Version control
.git
.gitignore

# Environment files — NEVER bake secrets into the image
.env
.env.*
!.env.example

# Python cache / build artifacts
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd
**/*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov/
.coverage

# Python virtual environments
.venv
venv
env

# Frontend build artifacts and dependencies (built inside Docker)
frontend/node_modules
frontend/dist
frontend/.vite

# Data files (not needed in container)
data/

# Documentation
docs/

# IDE / editor config
.vscode
.idea
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# Test / dev scripts
*.bat
locustfile.py
